---
interface Props { kind: string; compact?: boolean; }
const { kind, compact = false } = Astro.props;
---
<div class:list={['project-art', `art-${kind}`, { 'art-compact': compact }]} aria-hidden="true">
  <span class="art-coordinate mono">{kind === 'tailor' ? 'APPLICATION KIT' : kind === 'sentinel' ? 'SCHEMA SCANNER' : kind === 'observatory' ? 'DATA OBSERVATORY' : 'PROJECT FILE'}</span>
  {kind === 'tailor' ? (
    <svg viewBox="0 0 520 330" fill="none">
      <g stroke="#243638" stroke-width="3" stroke-linejoin="round">
        <path d="m235 63 182 25-22 226-183-25Z" fill="#bdc9b3"/>
        <path d="m245 56 182 25-22 226-183-25Z" fill="#ece7d3"/>
        <path d="m269 96 129 17m-132 8 112 14m-115 11 98 12" stroke="#71867b" stroke-width="5"/>
        <path d="m87 85 181-28 34 228-182 27Z" fill="#21383c"/>
        <path d="m99 72 181-28 34 229-182 26Z" fill="#f8efda"/>
        <path d="m115 89 11 74 151-22-11-75Z" fill="#d85a37"/>
        <path d="m133 190 127-18m-122 40 120-18m-117 39 87-13" stroke="#91a48c" stroke-width="7"/>
        <path d="m157 260 76-10" stroke="#243638" stroke-width="4"/>
        <path d="m322 181 47-6 13 78-47 7Z" fill="#f2c562"/>
        <path d="m337 214 12 10 19-27" stroke="#29443e" stroke-width="5"/>
      </g>
      <text x="147" y="142" fill="#fff5df" font-family="monospace" font-size="35" font-weight="bold" transform="rotate(-8 147 142)">CV_</text>
      <text x="270" y="180" fill="#243638" font-family="monospace" font-size="14" transform="rotate(8 270 180)">ROLE → FACTS</text>
      <path d="M384 36h39m-19-19v39M67 224h22m-11-11v22" stroke="#d85a37" stroke-width="3"/>
    </svg>
  ) : kind === 'sentinel' ? (
    <svg viewBox="0 0 520 330" fill="none">
      <g stroke="#172c33" stroke-width="4" stroke-linejoin="round">
        <path d="m105 70 309 9-13 208-312-8Z" fill="#7c9c91"/>
        <path d="m90 53 309 9-14 208-312-8Z" fill="#bbcbb0"/>
        <path d="m105 74 274 8-9 149-274-7Z" fill="#233c43"/>
        <path d="m226 270-2 26-83-3v13l175 6 1-14-65-1 2-26" fill="#637f79"/>
        <path d="m95 239 66 2m170 3 30 1" stroke="#526b64"/>
      </g>
      <g font-family="monospace" transform="rotate(2 110 90)">
        <text x="122" y="112" fill="#b6d3b8" font-size="15">$ validate tools.json</text>
        <text x="122" y="150" fill="#d7e4d1" font-size="15">"$ref": "#/Location"</text>
        <rect x="115" y="173" width="228" height="39" fill="#804438" stroke="#dd8a69"/>
        <text x="127" y="199" fill="#ffe3bb" font-size="18">! SS-REF-001</text>
      </g>
      <path d="m392 38 42 24-8 46-40 22-41-25 8-45Z" fill="#e3b55a" stroke="#1c3237" stroke-width="3"/>
      <path d="m386 54 22 12-4 28-21 13-22-13 4-27Z" fill="none" stroke="#2d4645" stroke-width="3"/>
      <path d="m384 69-1 16m0 9v2" stroke="#2d4645" stroke-width="5"/>
    </svg>
  ) : kind === 'observatory' ? (
    <svg viewBox="0 0 520 330" fill="none">
      <g stroke="#263c3e" stroke-width="3" stroke-linejoin="round">
        <path d="m83 102 136-33 29 217-134 31Z" fill="#2a4449"/>
        <path d="m75 88 136-33 29 217-134 31Z" fill="#f0e8cd"/>
        <path d="m273 48 147 42-34 218-147-42Z" fill="#3b5858"/>
        <path d="m280 33 147 42-34 218-147-42Z" fill="#e8e7cb"/>
        <path d="m88 104 108-26 9 49-109 27Z" fill="#466c73"/>
        <path d="m293 56 119 34-8 44-118-33Z" fill="#c95936"/>
        <path d="m104 178 93-23m-90 44 93-23" stroke="#9aad98"/>
        <path d="m277 135 121 34m-124-14 121 34" stroke="#aab89c"/>
        <path d="m119 262-5-29 14-3 5 29Zm27-6-9-60 14-3 9 60Zm29-7-6-39 14-3 6 39Zm27-7-11-71 14-3 11 71Z" fill="#577c73"/>
        <path d="m270 234 8-54 15 5-8 54Zm29 8 7-36 15 5-7 36Zm27 8 12-64 15 5-12 64Zm29 8 8-42 15 5-8 42Z" fill="#c37449"/>
      </g>
      <text x="131" y="133" fill="#f3eed7" font-family="monospace" font-size="25" font-weight="bold" transform="rotate(-13 131 133)">SE</text>
      <text x="321" y="99" fill="#fff0d9" font-family="monospace" font-size="25" font-weight="bold" transform="rotate(15 321 99)">DE</text>
      <path d="M40 69h27m-14-13v26M446 234h27m-13-13v26" stroke="#805134" stroke-width="3"/>
    </svg>
  ) : (
    <svg viewBox="0 0 520 330" fill="none"><path d="M133 67h222l32 31v196H133Z" fill="#f1e5c8" stroke="#233c42" stroke-width="4"/><path d="M168 130h161m-161 37h130m-130 37h145" stroke="#749385" stroke-width="8"/><text x="162" y="262" fill="#ac4b32" font-family="monospace" font-size="30">&lt;/&gt;_</text></svg>
  )}
  <span class="art-footnote mono">ILLUSTRATION{kind === 'observatory' ? ' / NOT LIVE DATA' : ''}</span>
</div>
