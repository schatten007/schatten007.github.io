---
import { site } from '../data/site';
interface Props { large?: boolean; }
const { large = false } = Astro.props;
---
<a class:list={['wordmark', { 'wordmark-large': large }]} href="/" aria-label={`${site.handle} — home`}>
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 25V7h10v7h12v11H17v-7H5Z" stroke="currentColor" stroke-width="2.2"/><path d="M21 3h7v7" stroke="currentColor" stroke-width="2"/></svg>
  <span>{site.handle}<span class="wordmark-dot">.</span></span>
</a>
