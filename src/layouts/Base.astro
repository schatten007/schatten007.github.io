---
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import Icon from '../components/Icon.astro';
import { site, navigation } from '../data/site';
import { getProjects, getNotes } from '../lib/content';

interface Props { title?: string; description?: string; class?: string; }
const { title, description = site.description, class: pageClass = '' } = Astro.props;
const fullTitle = title ? `${title} — Schatten` : site.title;
const canonical = new URL(Astro.url.pathname, site.url);
const [projects, notes] = await Promise.all([getProjects(), getNotes()]);
const searchEntries = [
  ...projects.map(({ id, data }) => ({ title: data.title, description: data.description, type: 'Project', href: `/work/${id}/`, keywords: data.tags.join(' ') })),
  ...notes.map(({ id, data }) => ({ title: data.title, description: data.description, type: 'Note', href: `/notes/${id}/`, keywords: data.category })),
  { title: 'The lab', description: 'One schema bug, three versions. Run the check.', type: 'Page', href: '/lab/', keywords: 'experiment playground MCP' },
  { title: 'About & experience', description: 'Software engineer in Deggendorf. Ex-consultancy co-founder, now M.Sc. student.', type: 'Page', href: '/about/', keywords: 'education skills certificates profile' },
  { title: 'CV / the short version', description: 'One page: experience, education, projects. Prints cleanly.', type: 'Page', href: '/cv/', keywords: 'resume download print experience' },
];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171310" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="schatten — H. A." />
    <meta property="og:image" content={`${site.url}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="schatten. I build tools that show their work. CV Tailor, SchemaSentinel, labour data." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner container">
        <div class="brand-group"><Wordmark /><span class="brand-caption mono">H. A.<br />PROJECTS & NOTES</span></div>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(({ label, href }) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}{label === 'Work' && <sup>{String(projects.length).padStart(2, '0')}</sup>}</a>)}
        </nav>
        <div class="header-actions">
          <button class="search-trigger icon-button js-only" aria-label="Search the site" aria-haspopup="dialog"><Icon name="search" size={17} /><kbd>⌘ K</kbd></button>
          <a class="contact-nav" href="/#contact">Let’s talk <Icon size={15} /></a>
          <button class="mobile-toggle icon-button js-only" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" /></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
        {navigation.map(({ label, href }) => <a href={href}>{label}<Icon size={20} /></a>)}
        <a href="/cv/">CV / the short version<Icon name="file" /></a>
      </nav>
    </header>

    <main id="main" tabindex="-1"><slot /></main>

    <footer class="site-footer" id="contact">
      <div class="container">
        <div class="footer-topline mono"><span><span class="status-dot"></span> CONTACT</span><span>05 / CONTACT</span></div>
        <div class="footer-main">
          <h2>If you’re hiring,<br /><em>let’s talk.</em><span class="footer-asterisk" aria-hidden="true">✳</span></h2>
          <div class="footer-contact"><p>I’m in Deggendorf, open to working-student and AI/automation roles in Germany, remote or on-site.<br />Tell me what you’re trying to build.</p>
            <a class="button button-lime" href={site.email ? `mailto:${site.email}` : site.github} target={site.email ? undefined : '_blank'} rel="noreferrer">{site.email ? 'Send me a message' : 'Find me on GitHub'}<Icon /></a>
            <div class="footer-secondary"><a class="text-link" href="/cv/">View my CV <Icon name="file" size={16} /></a>{site.linkedin && <a class="text-link" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <Icon size={15} /></a>}<button class="text-link js-only" data-copy-link={site.url}>Copy portfolio link <Icon name="copy" size={15} /></button></div>
            <span class="copy-status mono" data-copy-status role="status"></span>
          </div>
        </div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.handle}. Built by hand with Astro.</span><span class="footer-location"><span class="status-dot"></span> {site.location} <span data-local-time></span></span><a href={`${site.github}/schatten007.github.io`} target="_blank" rel="noreferrer">View source <Icon size={13} /></a><a href="#main" class="back-top" aria-label="Back to top">↑</a></div>
      </div>
    </footer>

    <dialog class="search-dialog" aria-labelledby="search-title">
      <div class="search-dialog-heading"><span id="search-title" class="mono">FIND YOUR WAY</span><button class="icon-button" data-close-search aria-label="Close search"><Icon name="close" /></button></div>
      <div class="search-input-wrap"><Icon name="search" size={24} /><input type="search" id="site-search" placeholder="Try “CV”, “schema”, or “jobs”…" aria-label="Search projects, notes, and pages" autocomplete="off" /></div>
      <div class="search-summary mono" role="status" aria-live="polite"></div>
      <div class="search-results"></div>
      <div class="search-hint mono"><span>↑ ↓ TO EXPLORE · ENTER TO OPEN</span><span>ESC TO CLOSE</span></div>
    </dialog>
    <script id="search-data" type="application/json" set:html={JSON.stringify(searchEntries).replace(/</g, '\\u003c')} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
