---
import '@fontsource-variable/manrope';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import Icon from '../components/Icon.astro';
import { site, navigation } from '../data/site';
import { getProjects, getNotes } from '../lib/content';

interface Props { title?: string; description?: string; class?: string; }
const { title, description = site.description, class: pageClass = '' } = Astro.props;
const fullTitle = title ? `${title} — Schatten / Save Point` : site.title;
const canonical = new URL(Astro.url.pathname, site.url);
const [projects, notes] = await Promise.all([getProjects(), getNotes()]);
const searchEntries = [
  ...projects.map(({ id, data }) => ({ title: data.title, description: data.description, type: 'Project', href: `/work/${id}/`, keywords: data.tags.join(' ') })),
  ...notes.map(({ id, data }) => ({ title: data.title, description: data.description, type: 'Note', href: `/notes/${id}/`, keywords: data.category })),
  { title: 'The lab', description: 'Try the power-budget model and the schema checker.', type: 'Page', href: '/lab/', keywords: 'experiment MCP hardware CPU cooling power tuning' },
  { title: 'About & experience', description: 'Software engineer, Master’s student, and hardware enthusiast in Deggendorf.', type: 'Page', href: '/about/', keywords: 'character education skills certificates profile anime games RPG Doom' },
  { title: 'CV', description: 'Experience, education, and selected projects. PDF available.', type: 'Page', href: '/cv/', keywords: 'resume download print experience' },
];
---
<!doctype html>
<html lang="en" class="no-js" data-motion="paused">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#202b2e" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SAVE POINT / SCHATTEN" />
    <meta property="og:image" content={`${site.url}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Save Point / Schatten. Software, hardware, and side quests. An original mechanic avatar beside One More Tweak." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      try {
        const paused = matchMedia('(prefers-reduced-motion: reduce)').matches || localStorage.getItem('save-point-motion') === 'paused';
        document.documentElement.dataset.motion = paused ? 'paused' : 'running';
      } catch { /* The static scene remains available without storage. */ }
    </script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner container">
        <div class="brand-group"><Wordmark /><span class="brand-caption mono">SAVE POINT<br /><span>SOFTWARE / SIDE QUESTS</span></span></div>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(({ label, href }, index) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}><span class="nav-index mono" aria-hidden="true">0{index + 1}</span>{label}</a>)}
        </nav>
        <div class="header-actions">
          <button class="search-trigger icon-button js-only" aria-label="Search the site" aria-haspopup="dialog"><Icon name="search" size={21} /><kbd>K</kbd></button>
          <a class="contact-nav" href="/cv/">CV <Icon name="file" size={18} /></a>
          <button class="mobile-toggle icon-button js-only" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" /></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
        {navigation.map(({ label, href }, index) => <a href={href}><span class="mono" aria-hidden="true">0{index + 1}</span>{label}<Icon size={20} /></a>)}
        <a href="/cv/"><span class="mono" aria-hidden="true">05</span>CV<Icon name="file" /></a>
      </nav>
    </header>

    <main id="main" tabindex="-1"><slot /></main>

    <footer class="site-footer" id="contact">
      <div class="container">
        <div class="footer-topline mono"><span>COMMUNICATIONS / OPEN A CHANNEL</span><span>DEGGENDORF, DE</span></div>
        <div class="footer-main">
          <div><span class="footer-prompt mono">GOT SOMETHING IN MIND?</span><h2>LET’S<br /><em>TALK.</em><span class="footer-arrow" aria-hidden="true">↗</span></h2></div>
          <div class="footer-contact">
            <p>If a project here is relevant to your team, I’d be glad to talk about it. You’ll find the code on GitHub and my background in the CV.</p>
            <a class="button button-gold" href={site.email ? `mailto:${site.email}` : site.github} target={site.email ? undefined : '_blank'} rel="noreferrer">{site.email ? 'SEND A MESSAGE' : 'GITHUB PROFILE'}<Icon /></a>
            <div class="footer-secondary">
              <a class="text-link" href="/cv/">View my CV <Icon name="file" size={18} /></a>
              {site.linkedin && <a class="text-link" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <Icon size={18} /></a>}
              <button class="text-link js-only" data-copy-link={site.url}>Copy site link <Icon name="copy" size={18} /></button>
            </div>
            <span class="copy-status mono" data-copy-status role="status"></span>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {site.handle} <span class="muted">/ built with Astro</span></span>
          <button class="motion-toggle js-only" data-toggle-motion aria-label="Play animations" aria-pressed="true"><span data-motion-icon aria-hidden="true">▷</span><span data-motion-text>Motion off</span></button>
          <a href={`${site.github}/schatten007.github.io`} target="_blank" rel="noreferrer">Site source <Icon size={16} /></a>
          <a href="#main" class="back-top">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <dialog class="search-dialog" aria-labelledby="search-title">
      <div class="search-dialog-heading"><span id="search-title" class="mono">QUICK SELECT</span><button class="icon-button" data-close-search aria-label="Close search"><Icon name="close" /></button></div>
      <div class="search-input-wrap"><Icon name="search" size={24} /><input type="search" id="site-search" placeholder="Search projects, notes, or hardware…" aria-label="Search projects, notes, and pages" autocomplete="off" /></div>
      <div class="search-summary mono" role="status" aria-live="polite"></div>
      <div class="search-results"></div>
      <div class="search-hint mono"><span>↑ ↓ SELECT · ENTER OPEN</span><span>ESC CLOSE</span></div>
    </dialog>
    <script id="search-data" type="application/json" set:html={JSON.stringify(searchEntries).replace(/</g, '\\u003c')} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
