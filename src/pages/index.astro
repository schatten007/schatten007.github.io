---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SignalSculpture from '../components/SignalSculpture.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteList from '../components/NoteList.astro';
import { getProjects, getNotes } from '../lib/content';
import { site } from '../data/site';
const projects = (await getProjects()).filter(project => project.data.featured).slice(0, 3);
const notes = (await getNotes()).slice(0, 2);
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-topline mono"><span><span class="status-dot"></span> {site.name} / SOFTWARE ENGINEER</span><span>DEGGENDORF, GERMANY</span></div>
    <div class="hero-grid">
      <div class="hero-copy"><p class="hero-eyebrow mono">SOFTWARE ENGINEER · M.SC. STUDENT · DEGGENDORF</p><h1 id="hero-title">I build tools<br /><em>that show their work.</em></h1><p class="hero-description">I’m H. A. Recent work: CV Tailor, SchemaSentinel, and a labour-market data project. Each write-up says what it does, where it’s rough, and where the code is.</p><div class="hero-actions"><a class="button button-lime" href="#selected-work">See the projects <Icon name="arrow-down" size={19} /></a><a class="text-link" href="/about/">About me <Icon size={17} /></a></div></div>
      <SignalSculpture />
    </div>
    <div class="hero-bottomline"><div class="hero-current"><span class="mono">NOW</span><span>M.Sc. Applied Computer Science, plus CV Tailor and SchemaSentinel</span></div><div class="hero-degree"><span class="tiny-cross" aria-hidden="true">+</span><span>M.Sc. Applied Computer Science<br /><span class="muted">Deggendorf Institute of Technology</span></span></div><a class="scroll-cue mono" href="#selected-work">SCROLL <span>↓</span></a></div>
  </section>

  <div class="principle-strip" aria-label="Recent work: CV Tailor, SchemaSentinel, Labour Observatory, lab demo."><div class="container"><span>CV Tailor</span><span class="strip-star" aria-hidden="true">✳</span><span>SchemaSentinel</span><span class="strip-star" aria-hidden="true">✳</span><span>Labour Observatory</span><span class="strip-star" aria-hidden="true">✳</span><span>Lab demo</span></div></div>

  <section class="section container" id="selected-work">
    <SectionLabel number="01" label="SELECTED WORK" extra="THREE PROJECTS WITH CODE" />
    <div class="section-heading"><h2>Work I can<br /><em>walk you through.</em></h2><div><p>Each one has code you can read and a short write-up: what it does, what I’d do differently, and where it ends.</p><a class="text-link" href="/work/">All projects <Icon name="arrow-right" size={18} /></a></div></div>
    <div class="selected-projects">{projects.map((project, index) => <ProjectCard project={project} index={index} featured={index === 0} />)}</div>
  </section>

  <section class="lab-teaser section" aria-labelledby="lab-heading"><div class="container"><SectionLabel number="02" label="THE LAB" extra="ONE BUG, THREE VERSIONS" /><div class="lab-teaser-grid"><div class="lab-teaser-copy"><span class="pill pill-outline mono">RUNS IN YOUR BROWSER</span><h2 id="lab-heading">What happens<br />if I <em>break this?</em></h2><p>A schema bug from SchemaSentinel, cut down to three small files. Pick one, run the check, read the result.</p><a class="button button-dark" href="/lab/">Enter the lab <Icon size={20} /></a></div><a class="lab-experiment-preview" href="/lab/" aria-label="Try the schema fault lab"><div class="lab-preview-top mono"><span>SCHEMA BUG</span><span>INTERACTIVE ↗</span></div><div class="fault-diagram"><div class="fault-node">&#123; &#125;<span class="mono">TOOL SCHEMA</span></div><div class="fault-connector"><span></span><b>?</b><span></span></div><div class="fault-node fault-node-dashed">$ref<span class="mono">MISSING TARGET</span></div></div><div class="lab-preview-bottom"><div><h3>One missing block.<br />Three different answers.</h3><span>See why exit 1, 0, and 2 are different.</span></div><span class="circle-arrow"><Icon name="arrow-right" /></span></div></a></div></div></section>

  <section class="section container"><SectionLabel number="03" label="FIELD NOTES" extra="TWO SHORT NOTES" /><div class="section-heading notes-heading"><h2>Two things I<br /><em>kept forgetting.</em></h2><a class="text-link" href="/notes/">All notes <Icon name="arrow-right" size={18} /></a></div><NoteList notes={notes} /></section>

  <section class="about-strip container"><div class="about-strip-symbol" aria-hidden="true">↳</div><div><span class="mono">04 / ABOUT</span><h2>I’m H. A.,<br /><em>based in Deggendorf.</em></h2></div><div class="about-strip-copy"><p>I used to build client apps full-time. Now I’m doing a master’s and spending most of my time on AI tooling and automation.</p><a class="text-link" href="/about/">More about me <Icon size={18} /></a></div></section>
</Base>
