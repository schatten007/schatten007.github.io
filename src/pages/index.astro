---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SignalSculpture from '../components/SignalSculpture.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteList from '../components/NoteList.astro';
import { getProjects, getNotes } from '../lib/content';
import { site } from '../data/site';
const projects = (await getProjects()).filter(project => project.data.featured).slice(0, 3);
const notes = (await getNotes()).slice(0, 2);
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-topline mono"><span><span class="status-dot"></span> {site.name} / SOFTWARE ENGINEER</span><span>BASED IN GERMANY · BUILDING EVERYWHERE</span></div>
    <div class="hero-grid">
      <div class="hero-copy"><p class="hero-eyebrow mono">APPLIED AI. USEFUL AUTOMATION. A LITTLE OBSESSION.</p><h1 id="hero-title">Curiosity,<br /><em>engineered.</em><span class="hero-period">✳</span></h1><p class="hero-description">I build AI workflows and the systems around them. Then I take them apart, test the edges, and share what holds up.</p><div class="hero-actions"><a class="button button-lime" href="#selected-work">Explore the work <Icon name="arrow-down" size={19} /></a><a class="text-link" href="/about/">The person behind it <Icon size={17} /></a></div></div>
      <SignalSculpture />
    </div>
    <div class="hero-bottomline"><div class="hero-current"><span class="mono">CURRENTLY IN ORBIT</span><span>AI agents & systems you can trust</span></div><div class="hero-degree"><span class="tiny-cross" aria-hidden="true">+</span><span>M.Sc. Applied Computer Science<br /><span class="muted">Deggendorf Institute of Technology</span></span></div><a class="scroll-cue mono" href="#selected-work">SCROLL TO DISCOVER <span>↓</span></a></div>
  </section>

  <div class="principle-strip" aria-label="Think in systems. Build with intent. Leave a trail."><div class="container"><span>Think in systems.</span><span class="strip-star" aria-hidden="true">✳</span><em>Build with intent.</em><span class="strip-star" aria-hidden="true">✳</span><span>Leave a trail.</span><span class="strip-star" aria-hidden="true">✳</span><em>Stay curious.</em></div></div>

  <section class="section container" id="selected-work">
    <SectionLabel number="01" label="SELECTED WORK" extra="IDEAS THAT MADE IT OUT OF MY HEAD" />
    <div class="section-heading"><h2>Less talk.<br /><em>More artifacts.</em></h2><div><p>Useful things, built with intent.<br />The decisions, the details, and the evidence.</p><a class="text-link" href="/work/">All projects <Icon name="arrow-right" size={18} /></a></div></div>
    <div class="selected-projects">{projects.map((project, index) => <ProjectCard project={project} index={index} featured={index === 0} />)}</div>
  </section>

  <section class="lab-teaser section" aria-labelledby="lab-heading"><div class="container"><SectionLabel number="02" label="THE LAB" extra="SMALL QUESTIONS. INTERESTING ANSWERS." /><div class="lab-teaser-grid"><div class="lab-teaser-copy"><span class="pill pill-outline mono">HANDS-ON / IN YOUR BROWSER</span><h2 id="lab-heading">What happens<br />if I <em>break this?</em></h2><p>The interesting part is usually at the edges. Step into a small experiment, change an input, and follow the failure.</p><a class="button button-dark" href="/lab/">Enter the lab <Icon size={20} /></a></div><a class="lab-experiment-preview" href="/lab/" aria-label="Try the schema fault lab"><div class="lab-preview-top mono"><span>EXPERIMENT_001</span><span>INTERACTIVE ↗</span></div><div class="fault-diagram"><div class="fault-node">&#123; &#125;<span class="mono">TOOL SCHEMA</span></div><div class="fault-connector"><span></span><b>?</b><span></span></div><div class="fault-node fault-node-dashed">$ref<span class="mono">MISSING TARGET</span></div></div><div class="lab-preview-bottom"><div><h3>A tiny break.<br />A very confused agent.</h3><span>Explore the anatomy of a broken tool contract.</span></div><span class="circle-arrow"><Icon name="arrow-right" /></span></div></a></div></div></section>

  <section class="section container"><SectionLabel number="03" label="FIELD NOTES" extra="THINKING OUT LOUD, WITH RECEIPTS" /><div class="section-heading notes-heading"><h2>Notes from<br /><em>the rabbit hole.</em></h2><a class="text-link" href="/notes/">Open the notebook <Icon name="arrow-right" size={18} /></a></div><NoteList notes={notes} /></section>

  <section class="about-strip container"><div class="about-strip-symbol" aria-hidden="true">↳</div><div><span class="mono">04 / THE HUMAN IN THE LOOP</span><h2>Engineer by training.<br /><em>Curious by default.</em></h2></div><div class="about-strip-copy"><p>From building for clients to studying the systems beneath the surface. Now exploring where applied AI meets thoughtful software engineering.</p><a class="text-link" href="/about/">A little more about me <Icon size={18} /></a></div></section>
</Base>
