---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';
const projects = await getProjects();
const categories = ['All', ...new Set(projects.map(project => project.data.category))];
---
<Base title="Selected work" description="AI automation, developer tooling, and data systems. Explore the decisions and evidence behind each project.">
  <section class="page-intro container"><SectionLabel number="01" label="THE WORK INDEX" extra={`${String(projects.length).padStart(2, '0')} PUBLIC CASE STUDIES`} /><h1>Ideas are good.<br /><em>Artifacts are better.</em></h1><div class="page-intro-bottom"><p>A growing collection of useful things. Pick a project and look under the hood: the problem, the choices, the evidence, and the unfinished edges.</p><span class="mono">BUILT → EXPLAINED → OPEN-SOURCED</span></div></section>
  <section class="container work-section" aria-label="Project collection"><div class="work-toolbar js-only"><div class="filter-list" role="group" aria-label="Filter projects by category">{categories.map(category => <button data-filter={category} aria-pressed={category === 'All'}>{category}{category === 'All' && <span>{projects.length}</span>}</button>)}</div><span class="mono filter-status" data-filter-status role="status">{projects.length} projects</span></div><div class="work-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div><div class="index-colophon mono"><span>AN OPEN NOTEBOOK, NOT A FINISHED SHELF.</span><span>MORE TO COME ↗</span></div></section>
</Base>
