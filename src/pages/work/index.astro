---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';
const projects = await getProjects();
const categories = ['All', ...new Set(projects.map(project => project.data.category))];
---
<Base title="Mission select / Projects" description="Public projects in AI automation, developer tools, and data systems. Open a write-up to see the implementation and code.">
  <section class="page-intro container">
    <SectionLabel number="01" label="MISSION SELECT" extra={`${String(projects.length).padStart(2, '0')} PUBLIC PROJECTS`} />
    <h1>PICK A PROJECT.<br /><em>SEE THE BUILD.</em></h1>
    <div class="page-intro-bottom"><p>Each write-up covers what the project does, a decision worth explaining, and what still needs work. The source is linked throughout.</p><span class="mono">PROJECTS / IMPLEMENTATION / NOTES</span></div>
  </section>
  <section class="container work-section" aria-label="Project collection">
    <div class="work-toolbar js-only"><div class="filter-list" role="group" aria-label="Filter projects by category">{categories.map(category => <button data-filter={category} aria-pressed={category === 'All'}>{category}{category === 'All' && <span>{projects.length}</span>}</button>)}</div><span class="mono filter-status" data-filter-status role="status">{projects.length} projects</span></div>
    <div class="work-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <div class="index-colophon mono"><span>EVERY ENTRY LINKS TO ITS SOURCE.</span><span>MORE BUILDS TO COME.</span></div>
  </section>
</Base>
