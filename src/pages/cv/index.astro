---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { experience, education, skills } from '../../data/career';
import { getProjects } from '../../lib/content';
import { site } from '../../data/site';
const projects = await getProjects();
---
<Base title="CV / the short version" description="A concise, printable profile: experience, education, selected projects, and applied AI skills." class="cv-page">
  <section class="container cv-controls"><a class="breadcrumb mono" href="/about/">← THE HUMAN BEHIND THE CV</a><div><a class="button button-lime" href="/cv.pdf" download="HA-CV.pdf">Download PDF <Icon name="arrow-down" size={17} /></a><button class="button button-outline js-only" data-print-cv>Print / save PDF <Icon name="file" size={17} /></button></div></section>
  <article class="cv-document"><header class="cv-header"><div><span class="mono">THE SHORT VERSION</span><h1>{site.name}</h1><p>Software Engineer · M.Sc. Applied Computer Science</p></div><div class="cv-contact"><span>Deggendorf, Germany</span><a href={site.github}>github.com/{site.githubHandle}</a><a href={site.url}>schatten007.github.io</a></div></header><p class="cv-summary">Software engineer with experience co-founding a consultancy, leading a three-person team, and delivering mobile and web applications for international clients. Currently pursuing an M.Sc. in Applied Computer Science and building public projects in AI automation, developer tooling, and data systems.</p>
    <section><h2>Experience</h2>{experience.map(item => <div class="cv-entry"><div><h3>{item.role}</h3><span>{item.organization}</span></div><span class="cv-date">{item.period}</span><p>{item.description}</p></div>)}</section>
    <section><h2>Selected projects</h2>{projects.map(project => <div class="cv-entry cv-project"><div><h3><a href={`${site.url}/work/${project.id}/`}>{project.data.title} ↗</a></h3><span>{project.data.tags.join(' · ')}</span></div><p>{project.data.description}</p></div>)}</section>
    <section><h2>Education</h2>{education.map(item => <div class="cv-entry"><div><h3>{item.degree}</h3><span>{item.school}</span></div><span class="cv-date">{item.period}</span><p>{item.detail}</p></div>)}</section>
    <section><h2>Technical skills</h2><div class="cv-skills">{skills.map(group => <p><strong>{group.area}</strong><span>{group.items}</span></p>)}</div></section>
    <section><h2>Selected learning & languages</h2><p><strong>DataCamp:</strong> Associate AI Engineer for Developers, 29-hour track (Aug 2026).</p><p><strong>NVIDIA:</strong> CUDA Python, Transformer-based NLP, Deep Learning, and Diffusion Models — Certificates of Competency (Mar 2026).</p><p><strong>Languages:</strong> English C1 · German A2.</p></section>
    <footer class="cv-footnote">Public career summary · Detailed project evidence and full learning record at schatten007.github.io</footer>
  </article>
</Base>
