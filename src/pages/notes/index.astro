---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes } from '../../lib/content';
const notes = await getNotes();
---
<Base title="Quest log / Notes" description="Short technical notes about the design choices inside my projects.">
  <section class="page-intro container">
    <SectionLabel number="03" label="QUEST LOG" extra={`${String(notes.length).padStart(2, '0')} ENTRIES`} />
    <h1>NOTES FROM<br /><em>THE WORKBENCH.</em></h1>
    <div class="page-intro-bottom"><p>Some details deserve more space than a project card. These are short explanations of choices inside the code.</p><span class="mono">TECHNICAL NOTES / SOURCE LINKS INCLUDED</span></div>
  </section>
  <section class="container notes-index" aria-label="Technical notes"><NoteList notes={notes} /></section>
</Base>
