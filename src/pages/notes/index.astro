---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes } from '../../lib/content';
const notes = await getNotes();
---
<Base title="Notes to my future self" description="Short notes from building the projects. Mostly about where I went wrong first."><section class="page-intro container"><SectionLabel number="03" label="NOTES" extra="TWO ENTRIES" /><h1>Notes to<br /><em>my future self.</em></h1><div class="page-intro-bottom"><p>Short notes from building the projects above. Mostly about where I went wrong first.</p><span class="mono">SHORT ON PURPOSE</span></div></section><section class="container notes-index" aria-label="Technical notes"><NoteList notes={notes} /><div class="index-colophon mono"><span>I ADD NOTES WHEN I KEEP FORGETTING SOMETHING.</span><span>{String(notes.length).padStart(2, '0')} ENTRIES</span></div></section></Base>
