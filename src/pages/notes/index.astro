---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes } from '../../lib/content';
const notes = await getNotes();
---
<Base title="Field notes" description="Short technical notes on AI tools, data systems, and the engineering decisions worth remembering."><section class="page-intro container"><SectionLabel number="03" label="THE NOTEBOOK" extra="IDEAS WORTH KEEPING" /><h1>Follow the<br /><em>interesting bit.</em></h1><div class="page-intro-bottom"><p>Small observations from building things. The kind of notes I’d want to find when a problem sends me down a rabbit hole.</p><span class="mono">LESS CONTENT. MORE CONTEXT.</span></div></section><section class="container notes-index" aria-label="Technical notes"><NoteList notes={notes} /><div class="index-colophon mono"><span>A NOTEBOOK GROWS ONE GOOD QUESTION AT A TIME.</span><span>{String(notes.length).padStart(2, '0')} ENTRIES</span></div></section></Base>
