---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Icon from '../../components/Icon.astro';
import { experience, education, skills, credentials } from '../../data/career';
import { site } from '../../data/site';
---
<Base title="Character sheet / About" description="H. A., software engineer and Master’s student in Deggendorf. AI automation, hardware tuning, anime, RPGs, and old-school shooters.">
  <section class="page-intro container">
    <SectionLabel number="04" label="CHARACTER SHEET" extra="THE PERSON AT THE KEYBOARD" />
    <div class="about-hero-grid">
      <div>
        <h1>HI, I’M {site.name}<br /><em>HERE’S MY BUILD.</em></h1>
        <p class="about-intro-text">I’m a software engineer doing an M.Sc. in Applied Computer Science at Deggendorf Institute of Technology. My recent projects are in AI automation and developer tools. I’m also the sort of person who enjoys a good settings menu.</p>
        <div class="hero-actions"><a class="button button-primary" href="/cv/">OPEN MY CV <Icon name="file" /></a><a class="text-link" href="/#contact">Get in touch <Icon /></a></div>
      </div>
      <div class="identity-card">
        <div class="identity-top mono"><span>PLAYER / 01</span><span>SCHATTEN007</span></div>
        <img src="/art/mechanic.svg" alt="Original mechanic avatar illustration." width="560" height="560" />
        <div class="identity-bottom"><strong>{site.name}</strong><span class="mono">SOFTWARE ENGINEER<br />DEGGENDORF, DE</span></div>
      </div>
    </div>
  </section>
  <section class="about-content container">
    <div class="about-section-label"><span class="mono">BACKGROUND</span><h2>CLIENT WORK.<br /><em>THEN A MASTER’S.</em></h2></div>
    <div class="about-narrative">
      <p>I started as a freelance developer, building mobile and web apps for international clients. Flutter and Firebase were a big part of that work.</p>
      <p>Later, I co-founded Eule, a software consultancy, and led a team of three. The job covered requirements, development, deployment, and maintenance.</p>
      <p>I began my Master’s in October 2025. The projects on this site are what I’m building alongside it: tools for job applications, checks for AI tool schemas, and a pipeline for public job-posting data.</p>
    </div>
  </section>
  <section class="interest-inventory container" aria-label="Interests outside the projects">
    <div class="interest-item"><Icon name="wrench" size={31} /><span class="mono">SIDE QUEST / 01</span><h3>Hardware tuning</h3><p>Laptops, desktops, performance optimization, and overclocking. I like understanding where the limits come from.</p></div>
    <div class="interest-item"><Icon name="gamepad" size={31} /><span class="mono">SIDE QUEST / 02</span><h3>RPGs & shooters</h3><p>RPGs on one side, Doom and other boomer shooters on the other. The menus and machinery here borrow a bit from both.</p></div>
    <div class="interest-item"><Icon name="crosshair" size={31} /><span class="mono">SIDE QUEST / 03</span><h3>Anime</h3><p>The character art is a nod to that interest. A mechanic with an open laptop felt right for this site.</p></div>
  </section>
  <section class="container experience-section">
    <div class="two-col-heading"><span class="mono">EXPERIENCE LOG</span><h2>WHERE I’VE<br /><em>WORKED.</em></h2></div>
    <div class="timeline">{experience.map(item => <div class="timeline-row"><span class="mono timeline-period">{item.period}</span><div><h3>{item.role}</h3><span class="timeline-org">{item.organization}</span><p>{item.description}</p></div><span class="timeline-mark" aria-hidden="true">↗</span></div>)}</div>
  </section>
  <section class="container about-learning">
    <div><span class="mono">EDUCATION</span><h2>THE BACKGROUND.</h2>{education.map(item => <div class="education-item"><span class="mono">{item.period}</span><h3>{item.degree}</h3><p>{item.school}</p><small>{item.detail}</small></div>)}</div>
    <div class="toolbox"><span class="mono">TOOL INVENTORY</span>{skills.map(group => <div><h3>{group.area}</h3><p>{group.items}</p></div>)}<div><h3>Languages</h3><p>English · C1<br />German · A2</p></div></div>
  </section>
  <section class="container credentials-section">
    <div class="section-heading"><div><span class="mono">COURSE LOG</span><h2>RECENT<br /><em>LEARNING.</em></h2></div><p>Courses in AI applications, deep learning, and accelerated computing, completed in 2026.</p></div>
    <div class="credential-featured"><span class="credential-seal" aria-hidden="true">✳</span><div><span class="mono">DATACAMP / AUGUST 2026</span><h3>Associate AI Engineer<br />for Developers</h3><p>29-hour learning track</p></div><span class="mono credential-badge">COMPLETED</span></div>
    {['NVIDIA', 'DataCamp'].map(issuer => <details class="credential-group"><summary><span>{issuer === 'NVIDIA' ? 'NVIDIA · accelerated computing & deep learning' : 'DataCamp · applied AI & software engineering'}</span><span class="mono">{credentials.filter(item => item.issuer === issuer && item.type !== '29-hour track').length} COURSES <b>+</b></span></summary><div class="credential-list">{credentials.filter(item => item.issuer === issuer && item.type !== '29-hour track').map(item => <div><span>{item.title}</span><span class="mono">{item.date}</span></div>)}</div></details>)}
  </section>
</Base>
