---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Icon from '../../components/Icon.astro';
import { experience, education, skills, credentials } from '../../data/career';
import { site } from '../../data/site';
---
<Base title="About H. A." description="Software engineer in Deggendorf. Ex-consultancy co-founder, now doing an M.Sc. in Applied Computer Science.">
  <section class="page-intro container"><SectionLabel number="04" label="ABOUT" extra={`HI, I’M ${site.name.toUpperCase()}`} /><div class="about-hero-grid"><div><h1>I’m H. A.<br /><em>I build software in Deggendorf.</em></h1><p class="about-intro-text">I’m doing an M.Sc. in Applied Computer Science at Deggendorf Institute of Technology. Before that I ran a small consultancy with two other people and did freelance Flutter and web work.</p><div class="hero-actions"><a class="button button-lime" href="/cv/">The CV version <Icon name="file" size={18} /></a><a class="text-link" href="/#contact">Contact <Icon /></a></div></div><div class="identity-card"><div class="identity-top mono"><span>FIELD ID / 007</span><span>DE · PK</span></div><span class="identity-monogram" aria-hidden="true">h<span>a</span><b>✳</b></span><div class="identity-bottom"><strong>{site.name}</strong><span class="mono">SOFTWARE ENGINEER<br />M.SC. STUDENT</span></div></div></div></section>
  <section class="about-content container"><div class="about-section-label"><span class="mono">BACKGROUND</span><h2>From client work<br />to a <em>master’s.</em></h2></div><div class="about-narrative"><p>I did freelance mobile and web work from August 2022 to October 2023, mostly Flutter and Firebase for clients abroad. In October 2023 I started Eule with two others. We built full-stack web apps and I handled most of the client calls, planning, and releases until January 2025.</p><p>Since October 2025 I’ve been studying full-time in Deggendorf. Most of my time goes into AI tooling and automation now: CV Tailor, SchemaSentinel, and a data project on job postings. I’m still interested in systems and performance underneath, but the day-to-day is Python, TypeScript, and reading other people’s schemas.</p><p>This site is where I keep the projects I can explain. Code first, then a short write-up with the rough edges left in.</p></div></section>
  <section class="container experience-section"><div class="two-col-heading"><span class="mono">EXPERIENCE</span><h2>Where I’ve<br /><em>worked.</em></h2></div><div class="timeline">{experience.map(item => <div class="timeline-row"><span class="mono timeline-period">{item.period}</span><div><h3>{item.role}</h3><span class="timeline-org">{item.organization}</span><p>{item.description}</p></div><span class="timeline-mark" aria-hidden="true">↗</span></div>)}</div></section>
  <section class="container about-learning"><div><span class="mono">EDUCATION</span><h2>Education.</h2>{education.map(item => <div class="education-item"><span class="mono">{item.period}</span><h3>{item.degree}</h3><p>{item.school}</p><small>{item.detail}</small></div>)}</div><div class="toolbox"><span class="mono">TOOLS I USE</span>{skills.map(group => <div><h3>{group.area}</h3><p>{group.items}</p></div>)}<div><h3>Human languages</h3><p>English · C1<br />German · A2</p></div></div></section>
  <section class="container credentials-section"><div class="section-heading"><div><span class="mono">COURSES</span><h2>Courses<br /><em>I finished.</em></h2></div><p>DataCamp and NVIDIA courses from March and August 2026.<br />Useful background, not a substitute for the projects.</p></div><div class="credential-featured"><span class="credential-seal" aria-hidden="true">✳</span><div><span class="mono">DATACAMP / AUGUST 2026</span><h3>Associate AI Engineer<br />for Developers</h3><p>29-hour learning track</p></div><span class="mono credential-badge">COMPLETED ↗</span></div>{['NVIDIA', 'DataCamp'].map(issuer => <details class="credential-group"><summary><span>{issuer === 'NVIDIA' ? 'NVIDIA · accelerated computing & deep learning' : 'DataCamp · applied AI & software engineering'}</span><span class="mono">{credentials.filter(item => item.issuer === issuer && item.type !== '29-hour track').length} COURSES <b>+</b></span></summary><div class="credential-list">{credentials.filter(item => item.issuer === issuer && item.type !== '29-hour track').map(item => <div><span>{item.title}</span><span class="mono">{item.date}</span></div>)}</div></details>)}</section>
</Base>
