---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Icon from '../../components/Icon.astro';
import { experience, education, skills, credentials } from '../../data/career';
import { site } from '../../data/site';
---
<Base title="The human in the loop" description="Software engineer, former consultancy co-founder, and Master's student in Applied Computer Science in Germany. Curious about AI, automation, and systems.">
  <section class="page-intro container"><SectionLabel number="04" label="THE HUMAN IN THE LOOP" extra={`HELLO, I’M ${site.name.toUpperCase()}`} /><div class="about-hero-grid"><div><h1>A builder.<br /><em>Always a learner.</em></h1><p class="about-intro-text">I’m a software engineer and Master’s student in Applied Computer Science in Germany. I like turning complicated problems into useful software — and understanding what’s happening underneath.</p><div class="hero-actions"><a class="button button-lime" href="/cv/">The CV version <Icon name="file" size={18} /></a><a class="text-link" href="/#contact">Let’s connect <Icon /></a></div></div><div class="identity-card"><div class="identity-top mono"><span>FIELD ID / 007</span><span>DE · PK</span></div><span class="identity-monogram" aria-hidden="true">h<span>a</span><b>✳</b></span><div class="identity-bottom"><strong>{site.name}</strong><span class="mono">SOFTWARE ENGINEER<br />PERPETUALLY CURIOUS</span></div></div></div></section>
  <section class="about-content container"><div class="about-section-label"><span class="mono">THE THROUGH-LINE</span><h2>From shipping for clients<br />to asking <em>better questions.</em></h2></div><div class="about-narrative"><p>I started with freelance mobile and web development, then co-founded a small software consultancy. Working directly with clients taught me to care about the whole path: what someone actually needs, how the system behaves, and what happens after deployment.</p><p>Now I’m pursuing an M.Sc. at Deggendorf Institute of Technology. My current work brings that delivery mindset into AI automation and developer tools, with an interest in systems programming and high-performance computing underneath it all.</p><p>This fieldbook is where those threads meet. Useful artifacts, experiments with a clear question, and notes that make the next difficult thing a little easier.</p></div></section>
  <section class="container experience-section"><div class="two-col-heading"><span class="mono">EXPERIENCE / THE PATH SO FAR</span><h2>Built for people.<br /><em>Learned by doing.</em></h2></div><div class="timeline">{experience.map(item => <div class="timeline-row"><span class="mono timeline-period">{item.period}</span><div><h3>{item.role}</h3><span class="timeline-org">{item.organization}</span><p>{item.description}</p></div><span class="timeline-mark" aria-hidden="true">↗</span></div>)}</div></section>
  <section class="container about-learning"><div><span class="mono">EDUCATION</span><h2>A strong foundation.<br /><em>An open mind.</em></h2>{education.map(item => <div class="education-item"><span class="mono">{item.period}</span><h3>{item.degree}</h3><p>{item.school}</p><small>{item.detail}</small></div>)}</div><div class="toolbox"><span class="mono">THE WORKING TOOLBOX</span>{skills.map(group => <div><h3>{group.area}</h3><p>{group.items}</p></div>)}<div><h3>Human languages</h3><p>English · C1<br />German · A2</p></div></div></section>
  <section class="container credentials-section"><div class="section-heading"><div><span class="mono">LEARNING, WITH A PAPER TRAIL</span><h2>Keep adding<br /><em>new tools.</em></h2></div><p>Recent learning in applied AI and accelerated computing.<br />A foundation for the work, not a substitute for it.</p></div><div class="credential-featured"><span class="credential-seal" aria-hidden="true">✳</span><div><span class="mono">DATACAMP / AUGUST 2026</span><h3>Associate AI Engineer<br />for Developers</h3><p>29-hour learning track</p></div><span class="mono credential-badge">COMPLETED ↗</span></div>{['NVIDIA', 'DataCamp'].map(issuer => <details class="credential-group"><summary><span>{issuer === 'NVIDIA' ? 'NVIDIA · accelerated computing & deep learning' : 'DataCamp · applied AI & software engineering'}</span><span class="mono">{credentials.filter(item => item.issuer === issuer && item.type !== '29-hour track').length} COURSES <b>+</b></span></summary><div class="credential-list">{credentials.filter(item => item.issuer === issuer && item.type !== '29-hour track').map(item => <div><span>{item.title}</span><span class="mono">{item.date}</span></div>)}</div></details>)}</section>
</Base>
